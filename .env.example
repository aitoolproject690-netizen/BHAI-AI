# BHAI-X server configuration
# Add real values only in the host's protected Environment/Secrets panel.
# Never commit a filled-in .env file or paste secrets into chat.

NODE_ENV=production

# REQUIRED: create a PostgreSQL database in Botkeep and use its private connection URI.
DATABASE_URL=
# Use verify-full on Botkeep; disable only for a trusted private/local network database.
DATABASE_SSL_MODE=verify-full
# Optional PEM root CA contents provided by the database host (keep server-side).
DATABASE_SSL_CA=

# REQUIRED: owner login. Choose your own email, username, and strong password.
OWNER_EMAIL=
OWNER_USERNAME=bhai
OWNER_PASSWORD=

# REQUIRED for owner/admin controls that use X-Owner-Key. Set a separate long random secret.
OWNER_ACCESS_KEY=

# REQUIRED for background jobs that call back into this app. Set after the Botkeep HTTPS domain is assigned.
BHAI_PUBLIC_URL=

# Configure at least one text AI provider for AI responses.
GEMINI_API_KEY=
GEMINI_ROUTER_MODEL=gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=
POLLINATIONS_API_KEY=

# Optional: GitHub integration/build actions. Grant only the permissions your workflow requires.
GITHUB_TOKEN=

# Optional media providers. Leave blank unless configured and tested.
BHAI_IMAGE_URL=
BHAI_IMAGE_API_KEY=
BHAI_IMAGE_AUTH_HEADER=
BHAI_VIDEO_URL=
BHAI_VIDEO_API_KEY=
BHAI_TTS_URL=
BHAI_LIPSYNC_URL=
SYNC_API_KEY=
SYNC_LIPSYNC_MODEL=lipsync-2

# BHAI-CORE/mobile-node is intentionally disabled while the laptop/KVM work is paused.
# Do not point these to the suspended Render service.
BHAI_CORE_URL=
BHAI_CORE_API_KEY=
BHAI_CORE_INTERNAL_IMAGE_KEY=
BHAI_INTERNAL_SECRET=

# Optional YouTube OAuth/publishing.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=
BHAI_YOUTUBE_TOKEN_SECRET=
