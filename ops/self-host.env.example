# BHAI-X self-host environment.
# BHAI-X talks to Core over the shared Docker network by default.
BHAI_CORE_URL=http://bhai-core:10000
BHAI_CORE_API_KEY=replace-with-a-valid-bhai-core-key

# Optional: own NVIDIA-GPU image engine through the private BHAI-CORE bridge.
# Set BHAI_CORE_INTERNAL_IMAGE_KEY to the same independently generated secret in BHAI-CORE.
BHAI_IMAGE_URL=http://bhai-core:10000/v1/internal/image/generate
BHAI_IMAGE_API_KEY=replace-with-a-separate-long-random-image-bridge-secret
BHAI_IMAGE_AUTH_HEADER=x-bhai-internal-key
BHAI_X_DB_PASSWORD=replace-with-strong-db-password

# Optional BHAI-X providers:
GITHUB_TOKEN=
GEMINI_API_KEY=
POLLINATIONS_API_KEY=

# Set this only when a separate browser origin must call BHAI-X.
BHAI_CORS_ORIGIN=
